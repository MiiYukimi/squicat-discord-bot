# Create a Discord application and bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token

# Default language for replies when Discord does not supply a supported locale.
# Supported values: zh-TW, en-US
BOT_DEFAULT_LANGUAGE=zh-TW

# Optional: set a test server ID to sync Slash Commands immediately during development.
# Leave blank to use global commands (which can take up to about an hour to appear).
DEV_GUILD_ID=

# SQLite database location. On Railway, use a mounted Volume (for example /app/data/reminders.db).
DATABASE_PATH=data/reminders.db
